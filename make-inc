CC = arm-none-eabi-gcc
INCLUDES = \
	-I$(PWD)/experimental/\
	-I$(PWD)/experimental/hal\
	-I$(PWD)/experimental/drivers\
	-I$(PWD)/experimental/cmsis\
	-I$(PWD)/experimental/cmsis/TARGET_CORTEX_M\
	-I$(PWD)/experimental/rtos/source/TARGET_CORTEX\
	-I$(PWD)/experimental/rtos/source/TARGET_CORTEX/rtx5/Include\
	-I$(PWD)/experimental/rtos/source/TARGET_CORTEX/rtx5/RTX/Include\
	-I$(PWD)/experimental/rtos/source/TARGET_CORTEX/rtx5/RTX/Source\
	-I$(PWD)/experimental/rtos/source/TARGET_CORTEX/rtx5/RTX/Config\
	-I$(PWD)/experimental/platform\
	-I$(PWD)/experimental/platform/source\
	-I$(PWD)/experimental/platform/internal\
	-I$(PWD)/experimental/platform/cxxsupport\
	-I$(PWD)/experimental/targets/TARGET_NORDIC/\
	-I$(PWD)/experimental/targets/TARGET_NORDIC/TARGET_MCU_NRF51822/\
	-I$(PWD)/experimental/targets/TARGET_NORDIC/TARGET_MCU_NRF51822/device\
	-I$(PWD)/experimental/targets/TARGET_NORDIC/TARGET_MCU_NRF51822/TARGET_NRF51_MICROBIT
# TODO: find out if the DEVICE_ID_LENGTH is adequate
DEFINES = \
	-DNRF51\
	-DTARGET_M0\
	-DTOOLCHAIN_GCC\
	-DDEVICE_ANALOGIN\
	-DDEVICE_INTERRUPTIN\
	-DDEVICE_I2C\
	-DDEVICE_MPU\
	-DDEVICE_PORTIN\
	-DDEVICE_PWMOUT\
	-DDEVICE_SERIAL\
	-DDEVICE_SPI\
	-DDEVICE_USTICKER\
	-DDEVICE_SLEEP\
	-DDEVICE_SEMIHOST\
	-DDEVICE_LOCALFILESYSTEM\
	-DDEVICE_ID_LENGTH=255\
	-DMBED_CONF_TARGET_TICKLESS_FROM_US_TICKER\
	-DMBED_CONF_TARGET_INIT_US_TICKER_AT_BOOT\
	-DMBED_CONF_PLATFORM_CTHUNK_COUNT_MAX=128\
	-DMBED_ALL_STATS_ENABLED\
	-DMBED_CONF_RTOS_PRESENT\
	-DMBED_CONF_PLATFORM_USE_MPU
CCOPT=\
      $(DEFINES)\
      $(INCLUDES)\
      -O0\
      -mcpu=cortex-m0\
      -march=armv6-m
