include make-inc

all: $(OBJS) target

target:
	@$(MAKE) -C TARGET_CORTEX_M

$(MBED_ASSERT_OBJ): $(MBED_ASSERT_SRC)
	$(CC) $(CCOPT) -c $(MBED_ASSERT_SRC) -o $(MBED_ASSERT_OBJ)

$(MBED_ATOMIC_OBJ): $(MBED_ATOMIC_SRC)
	$(CC) $(CCOPT) -c $(MBED_ATOMIC_SRC) -o $(MBED_ATOMIC_OBJ)

$(MBED_BOARD_OBJ): $(MBED_BOARD_SRC)
	$(CC) $(CCOPT) -c $(MBED_BOARD_SRC) -o $(MBED_BOARD_OBJ)

$(MBED_CRITICAL_OBJ): $(MBED_CRITICAL_SRC)
	$(CC) $(CCOPT) -c $(MBED_CRITICAL_SRC) -o $(MBED_CRITICAL_OBJ)

$(MBED_ERROR_OBJ): $(MBED_ERROR_SRC)
	$(CC) $(CCOPT) -c $(MBED_ERROR_SRC) -o $(MBED_ERROR_OBJ)

$(MBED_ERROR_HIST_OBJ): $(MBED_ERROR_HIST_SRC)
	$(CC) $(CCOPT) -c $(MBED_ERROR_HIST_SRC) -o $(MBED_ERROR_HIST_OBJ)

$(MBED_INTERFACE_OBJ): $(MBED_INTERFACE_SRC)
	$(CC) $(CCOPT) -c $(MBED_INTERFACE_SRC) -o $(MBED_INTERFACE_OBJ)

$(MBED_MKTIME_OBJ): $(MBED_MKTIME_SRC)
	$(CC) $(CCOPT) -c $(MBED_MKTIME_SRC) -o $(MBED_MKTIME_OBJ)

$(MBED_MPU_MGMT_OBJ): $(MBED_MPU_MGMT_SRC)
	$(CC) $(CCOPT) -c $(MBED_MPU_MGMT_SRC) -o $(MBED_MPU_MGMT_OBJ)

$(MBED_POWER_MGMT_OBJ): $(MBED_POWER_MGMT_SRC)
	$(CC) $(CCOPT) -c $(MBED_POWER_MGMT_SRC) -o $(MBED_POWER_MGMT_OBJ)

$(MBED_SEMIHOST_API_OBJ): $(MBED_SEMIHOST_API_SRC)
	$(CC) $(CCOPT) -c $(MBED_SEMIHOST_API_SRC) -o $(MBED_SEMIHOST_API_OBJ)

$(MBED_STATS_OBJ): $(MBED_STATS_SRC)
	$(CC) $(CCOPT) -c $(MBED_STATS_SRC) -o $(MBED_STATS_OBJ)

$(AT_CMD_PARSER_OBJ): $(AT_CMD_PARSER_SRC)
	$(CC) $(CCOPT) -c $(AT_CMD_PARSER_SRC) -o $(AT_CMD_PARSER_OBJ)

$(CRITICAL_SECTION_LOCK_OBJ): $(CRITICAL_SECTION_LOCK_SRC)
	$(CC) $(CCOPT) -c $(CRITICAL_SECTION_LOCK_SRC) -o $(CRITICAL_SECTION_LOCK_OBJ)

$(CTHUNK_BASE_OBJ): $(CTHUNK_BASE_SRC)
	$(CC) $(CCOPT) -c $(CTHUNK_BASE_SRC) -o $(CTHUNK_BASE_OBJ)

$(DEEP_SLEEP_LOCK_OBJ): $(DEEP_SLEEP_LOCK_SRC)
	$(CC) $(CCOPT) -c $(DEEP_SLEEP_LOCK_SRC) -o $(DEEP_SLEEP_LOCK_OBJ)

$(FILE_BASE_OBJ): $(FILE_BASE_SRC)
	$(CC) $(CCOPT) -c $(FILE_BASE_SRC) -o $(FILE_BASE_OBJ)

$(FILE_HANDLE_OBJ): $(FILE_HANDLE_SRC)
	$(CC) $(CCOPT) -c $(FILE_HANDLE_SRC) -o $(FILE_HANDLE_OBJ)

$(FILE_PATH_OBJ): $(FILE_PATH_SRC)
	$(CC) $(CCOPT) -c $(FILE_PATH_SRC) -o $(FILE_PATH_OBJ)

$(FILE_SYSTEM_HANDLE_OBJ): $(FILE_SYSTEM_HANDLE_SRC)
	$(CC) $(CCOPT) -c $(FILE_SYSTEM_HANDLE_SRC) -o $(FILE_SYSTEM_HANDLE_OBJ)

$(LOCAL_FILE_SYSTEM_OBJ): $(LOCAL_FILE_SYSTEM_SRC)
	$(CC) $(CCOPT) -c $(LOCAL_FILE_SYSTEM_SRC) -o $(LOCAL_FILE_SYSTEM_OBJ)

$(MBED_ALLOC_WRAPPERS_OBJ): $(MBED_ALLOC_WRAPPERS_SRC)
	$(CC) $(CCOPT) -c $(MBED_ALLOC_WRAPPERS_SRC) -o $(MBED_ALLOC_WRAPPERS_OBJ)

$(MBED_MEM_TRACE_OBJ): $(MBED_MEM_TRACE_SRC)
	$(CC) $(CCOPT) -c $(MBED_MEM_TRACE_SRC) -o $(MBED_MEM_TRACE_OBJ)

$(MBED_OS_TIMER_OBJ): $(MBED_OS_TIMER_SRC)
	$(CC) $(CCOPT) -c $(MBED_OS_TIMER_SRC) -o $(MBED_OS_TIMER_OBJ)

$(MBED_RTC_TIME_OBJ): $(MBED_RTC_TIME_SRC)
	$(CC) $(CCOPT) -c $(MBED_RTC_TIME_SRC) -o $(MBED_RTC_TIME_OBJ)

$(MBED_THREAD_OBJ): $(MBED_THREAD_SRC)
	$(CC) $(CCOPT) -c $(MBED_THREAD_SRC) -o $(MBED_THREAD_OBJ)

$(MBED_STREAM_OBJ): $(MBED_STREAM_SRC)
	$(CC) $(CCOPT) -c $(MBED_STREAM_SRC) -o $(MBED_STREAM_OBJ)

clean:
	@$(MAKE) -C TARGET_CORTEX_M clean
	rm -f *.obj
